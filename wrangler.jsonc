{
  // Cloudflare config: static website + small worker for the mailing list.
  "name": "sambalzer-site",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/unsubscribe"]
  },
  // Mailing list storage
  "kv_namespaces": [
    { "binding": "SUBSCRIBERS", "id": "934cd1f208464221bd90f5fc8d3c4824" }
  ]
  // The email (EMAIL) binding for Proton notifications gets added once
  // Email Routing is set up on notify.sbalzer.com.
}
